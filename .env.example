# Manufacturing Production & Quality Control System
# Example environment configuration.
# Replace placeholder values in your local .env file.

# Application
APP_NAME=Manufacturing Production & Quality Control System
APP_VERSION=1.0.0
DEBUG=false

# Database (default project database)
DATABASE_URL=sqlite:///./manufacturing.db

# JWT Authentication
# Replace this placeholder with a strong, randomly generated secret.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_RUNNING
JWT_ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7